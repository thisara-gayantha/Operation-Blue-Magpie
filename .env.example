# =============================================================================
# Operation Blue Magpie — environment template
# Copy to .env (git-ignored) and fill in real values before `docker compose up`.
# =============================================================================
#
# IMAGE TAGS
# ----------
# Do NOT trust the placeholders below blindly. Before first build, pin each tag
# to a version you have verified exists on its registry (and ideally a @sha256
# digest for reproducibility). Leaving a tag unverified violates the project's
# "never invent a version number" rule.
#   CTFd:     https://hub.docker.com/r/ctfd/ctfd/tags
#   Postgres: https://hub.docker.com/_/postgres/tags
#   Redis:    https://hub.docker.com/_/redis/tags
#   Nginx:    https://hub.docker.com/_/nginx/tags
#   MySQL:    https://hub.docker.com/_/mysql/tags
# CTFD_IMAGE below is pinned to a verified multi-arch tag (has a native arm64
# build, so no emulation is needed on Apple Silicon). Bump it when you want a
# newer CTFd, checking the tag exists first.
CTFD_IMAGE=ctfd/ctfd:3.8.7
# Apple Silicon only: if the CTFd image has no arm64 build, set this to
# linux/amd64 to run it under emulation. Leave EMPTY on the Ubuntu x86_64 host.
CTFD_PLATFORM=
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.0

# -----------------------------------------------------------------------------
# Platform database (PostgreSQL) — backend_net only, never exposed to host
# -----------------------------------------------------------------------------
POSTGRES_DB=ctfd
POSTGRES_USER=ctfd
POSTGRES_PASSWORD=change-me-strong-random

# -----------------------------------------------------------------------------
# CTFd
# -----------------------------------------------------------------------------
# SQLAlchemy URL CTFd uses to reach PostgreSQL over backend_net.
DATABASE_URL=postgresql://ctfd:change-me-strong-random@ctfd_db:5432/ctfd
REDIS_URL=redis://ctfd_cache:6379
SECRET_KEY=change-me-64-char-random-hex
CTFD_WORKERS=2

# -----------------------------------------------------------------------------
# Public entry point (Nginx) — the only port published to the host
# -----------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
SERVER_NAME=localhost

# -----------------------------------------------------------------------------
# S4 — vulnerable web app + its OWN MySQL (challenge_net; never platform DB)
# -----------------------------------------------------------------------------
S4_HTTP_PORT=8004
MYSQL_ROOT_PASSWORD=change-me-s4-root
MYSQL_DATABASE=ceylonpay_app
MYSQL_USER=appuser
MYSQL_PASSWORD=change-me-s4-app

# -----------------------------------------------------------------------------
# S6 — vulnerable Linux/SSH box (challenge_net only)
# -----------------------------------------------------------------------------
S6_SSH_PORT=2226
