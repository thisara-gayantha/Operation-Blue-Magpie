# Operation Blue Magpie — S6 "Total Compromise" vulnerable Linux/SSH box. LAB ONLY.
#
# A participant SSHes in as the unprivileged `svc-deploy` account (credential
# recovered in S5) and escalates to root through a DELIBERATE SUID
# misconfiguration to read /root/flag.txt.
#
# Ubuntu 24.04 matches the locked host; the base image is multi-arch so it also
# builds on Apple Silicon (arm64) for Mac-side development.
#
# Build inputs (generated by scripts/gen_artifacts.py, git-ignored):
#   build/flag.txt      -> /root/flag.txt   (root-only; must escalate to read)
#   build/svc_pass.txt  -> svc-deploy's password (the S5 -> S6 hand-off)
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server findutils ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# --- unprivileged service account -------------------------------------------
ARG SVC_USER=svc-deploy
RUN useradd -m -s /bin/bash ${SVC_USER}
COPY build/svc_pass.txt /tmp/p
RUN echo "${SVC_USER}:$(cat /tmp/p)" | chpasswd && rm -f /tmp/p

# --- sshd (password auth for the service account; no root login) ------------
RUN mkdir -p /run/sshd && ssh-keygen -A \
 && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/'        /etc/ssh/sshd_config \
 && sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config

# --- DELIBERATE SUID misconfiguration (the intended priv-esc) ---------------
# `find` with the SUID bit set is a classic GTFOBins escalation:
#   find . -exec /bin/sh -p \; -quit    ->    euid-root shell
RUN chmod u+s /usr/bin/find

# --- root flag: readable only by root ---------------------------------------
COPY build/flag.txt /root/flag.txt
RUN chown root:root /root/flag.txt && chmod 600 /root/flag.txt

EXPOSE 22
# NOTE: do NOT add `no-new-privileges` to this container — it would disable the
# SUID escalation that IS the challenge. Isolation for S6 is provided by
# user-namespace remapping at the daemon level (so container-root != host-root),
# plus challenge_net + resource limits (see Step 8 / docs/build-notes.md).
CMD ["/usr/sbin/sshd", "-D", "-e"]
